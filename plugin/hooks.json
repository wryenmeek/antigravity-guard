{
  "antigravity-guard-hook": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "antigravity-guard hook-pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|read_file|view_file|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "antigravity-guard hook-post-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "antigravity-guard hook-stop",
        "timeout": 30
      }
    ]
  }
}
